# Database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=manicure_db

# Async database URL for backend
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/manicure_db

# Test database URL
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/manicure_test_db

# Auth & JWT
JWT_SECRET_KEY=change_me_to_a_secure_random_string_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30
COOKIE_SECURE=false
