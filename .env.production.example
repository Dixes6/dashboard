# ==============================================================================
# Manicure Dashboard - Production Environment Configuration
# ==============================================================================
# Скопируйте этот файл в .env.production на сервере и заполните значения:
#   cp .env.production.example .env.production
# ==============================================================================

# Доменное имя сервера (Caddy автоматически выпустит Let's Encrypt SSL-сертификат)
# Пример: manicure.example.com
DOMAIN=

# Режим окружения (в production отключаются Swagger UI /docs, /redoc, /openapi.json)
APP_ENV=production

# База данных PostgreSQL (сервис db внутри Docker Compose)
POSTGRES_USER=postgres
# Сгенерируйте надёжный пароль для базы данных, например:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
POSTGRES_DB=manicure_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL подключения к БД для бэкенда внутри Docker-сети
# Формат: postgresql+asyncpg://<USER>:<PASSWORD>@db:5432/<DB>
# Пример: postgresql+asyncpg://postgres:ВАШ_ПАРОЛЬ@db:5432/manicure_db
DATABASE_URL=

# Auth & JWT
# Секретный ключ для подписи JWT-токенов (минимум 32 символа).
# Сгенерировать командой:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

# Флаг Secure для куки авторизации (в production строго true для работы через HTTPS)
COOKIE_SECURE=true
